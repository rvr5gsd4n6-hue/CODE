-- Lab work No. 1 "Creating Tables" — Variant 17
-- PostgreSQL
-- Run this script in the database you created for this assignment.
-- Table "Disciplines" is the parent table; "Teaching_Load" is the dependent table.

-- On rerun, drop tables in the correct order.
DROP TABLE IF EXISTS public."Teaching_Load";
DROP TABLE IF EXISTS public."Disciplines";

CREATE TABLE public."Disciplines" (
    "discipline_id" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    "name"       VARCHAR(100) NOT NULL,
    "description"       TEXT,
    "year_introduced"   SMALLINT NOT NULL
        CHECK ("year_introduced" BETWEEN 1900 AND 2100)
);

CREATE TABLE public."Teaching_Load" (
    "teacher_id" INTEGER NOT NULL
        CHECK ("teacher_id" > 0),
    "discipline_id"    INTEGER NOT NULL,
    "hourly_rate"    NUMERIC(10,2) NOT NULL
        CHECK ("hourly_rate" >= 0),
    "hourly_pay"  NUMERIC(10,2) NOT NULL
        CHECK ("hourly_pay" >= 0),
    CONSTRAINT "pk_teaching_load"
        PRIMARY KEY ("teacher_id", "discipline_id"),
    CONSTRAINT "fk_teaching_load_disciplines"
        FOREIGN KEY ("discipline_id")
        REFERENCES public."Disciplines" ("discipline_id")
        ON UPDATE CASCADE
        ON DELETE CASCADE
);
